# Copy to .env for running the api or worker outside Docker. Never commit .env.
AWS_REGION=ap-south-1
# LocalStack in dev; leave unset on AWS
AWS_ENDPOINT_URL=http://localhost:4566
BUCKET=injectshield-prompts
QUEUE_URL=http://localhost:4566/000000000000/injectshield-scan
DATABASE_URL=postgresql://injectshield:injectshield@localhost:5432/injectshield

# Auth: true only for local development
AUTH_DISABLED=true
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
CORS_ORIGINS=*

# Scoring
THRESHOLD_SUSPICIOUS=0.4
THRESHOLD_MALICIOUS=0.7
CLASSIFIER_ENABLED=false
